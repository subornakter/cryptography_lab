# Simple DES - 1 Round

# Initial Permutation
IP = [
    58,50,42,34,26,18,10,2,
    60,52,44,36,28,20,12,4,
    62,54,46,38,30,22,14,6,
    64,56,48,40,32,24,16,8,
    57,49,41,33,25,17,9,1,
    59,51,43,35,27,19,11,3,
    61,53,45,37,29,21,13,5,
    63,55,47,39,31,23,15,7
]

# Expansion
E = [
    32,1,2,3,4,5,
    4,5,6,7,8,9,
    8,9,10,11,12,13,
    12,13,14,15,16,17,
    16,17,18,19,20,21,
    20,21,22,23,24,25,
    24,25,26,27,28,29,
    28,29,30,31,32,1
]

# P Box
P = [
    16,7,20,21,
    29,12,28,17,
    1,15,23,26,
    5,18,31,10,
    2,8,24,14,
    32,27,3,9,
    19,13,30,6,
    22,11,4,25
]

# First S Box only for simple 1-round demo
S1 = [
    [14,4,13,1,2,15,11,8,3,10,6,12,5,9,0,7],
    [0,15,7,4,14,2,13,1,10,6,12,11,9,5,3,8],
    [4,1,14,8,13,6,2,11,15,12,9,7,3,10,5,0],
    [15,12,8,2,4,9,1,7,5,11,3,14,10,0,6,13]
]


def binary(text):
    result = ""

    for ch in text:
        result += format(ord(ch), "08b")

    return result


def show(data, size=8):
    return " ".join(data[i:i+size] for i in range(0, len(data), size))


def permute(data, table):
    result = ""

    for i in table:
        result += data[i - 1]

    return result


def xor(a, b):
    result = ""

    for i in range(len(a)):
        if a[i] == b[i]:
            result += "0"
        else:
            result += "1"

    return result


def s_box(data):
    # এখানে 48 bit থেকে প্রথম 6 bit নেওয়া হচ্ছে
    # তাই এই simple program-এ একটি S-Box দেখানো হচ্ছে

    part = data[:6]

    row = int(part[0] + part[5], 2)
    col = int(part[1:5], 2)

    value = S1[row][col]

    return format(value, "04b")


# ---------------- MAIN ----------------

print("===================================")
print(" DES - 1 ROUND DEMO")
print("===================================")

message = input("\nEnter 8 character message: ")
key = input("Enter 8 character key: ")

if len(message) != 8 or len(key) != 8:
    print("\nMessage and key must be exactly 8 characters.")

else:

    # Convert message to binary
    plaintext = binary(message)

    print("\n========== INPUT ==========")

    print("Message:")
    print(message)

    print("\nBinary:")
    print(show(plaintext))


    # Initial Permutation
    after_ip = permute(plaintext, IP)

    print("\n========== INITIAL PERMUTATION ==========")
    print(show(after_ip))


    # Divide into L and R
    L0 = after_ip[:32]
    R0 = after_ip[32:]

    print("\nL0:")
    print(show(L0))

    print("\nR0:")
    print(show(R0))


    # ---------------- ROUND 1 ----------------

    print("\n===================================")
    print(" ROUND 1")
    print("===================================")


    # Step 1: Expansion
    expanded = permute(R0, E)

    print("\n1. Expansion (32 -> 48 bit)")
    print(show(expanded))


    # Key-এর প্রথম 48 bit নেওয়া হয়েছে
    # শুধু demonstration সহজ রাখার জন্য
    key_binary = binary(key)
    round_key = key_binary[:48]

    print("\nRound Key:")
    print(show(round_key))


    # Step 2: XOR
    x = xor(expanded, round_key)

    print("\n2. XOR")
    print(show(x))


    # Step 3: S Box
    s = s_box(x)

    print("\n3. S-Box")
    print(show(s, 4))


    # P Box-এর জন্য 32 bit দরকার
    # তাই simple demonstration-এর জন্য
    # S-Box result repeat করা হয়েছে
    s32 = (s * 8)[:32]

    print("\nS-Box Output (32 bit demo):")
    print(show(s32, 4))


    # Step 4: P Box
    p = permute(s32, P)

    print("\n4. P-Box")
    print(show(p))


    # Step 5: XOR with L0
    new_R = xor(L0, p)

    print("\n5. XOR with L0")
    print("L0:")
    print(show(L0))

    print("\nP:")
    print(show(p))

    print("\nNew R1:")
    print(show(new_R))


    # Step 6: Swap
    L1 = R0
    R1 = new_R

    print("\n6. Swap")

    print("L1:")
    print(show(L1))

    print("\nR1:")
    print(show(R1))


    print("\n===================================")
    print(" ROUND 1 COMPLETE")
    print("===================================")
